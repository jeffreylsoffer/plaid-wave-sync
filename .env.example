PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
WAVE_ACCESS_TOKEN=your_wave_api_token
WAVE_BUSINESS_ID=optional_auto_detected

# JSON array (preferred):
PLAID_ACCESS_TOKENS=[{"name":"MyBank","token":"access-production-xxxxx","wave_account":"Business Checking (001)","type":"checking"}]

# Legacy colon-delimited format also supported:
# PLAID_ACCESS_TOKENS=MyBank:access-production-xxxxx:Business Checking (001):checking
